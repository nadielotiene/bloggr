<%- include("partials/header.ejs") %>

<% if (locals.post) { %>
  <form id="edit-form" action="/posts/<%= post.id %>?_method=PATCH" method="POST">
    <!-- <label for="title">Title</label> -->
    <input type="text" name="title" id="patch-title" value="<%= post.title %>" placeholder="Post title" required>
    <!-- <label for="body">Post</label> -->
    <textarea name="body" id="patch-body" rows="8" cols="50" maxlength="1500" placeholder="Write your post here" required><%= post.body %></textarea>
  </form>
  
  <form id="delete-form" action="/posts/<%= post.id %>?_method=DELETE" method="POST"></form>
  
  <form id="cancel-form" action="/"></form>
  
  <div class="button-group">
    <button form="delete-form" class="delete btn" type="submit">Delete</button>
    <button form="cancel-form" class="cancel btn" type="submit">Cancel</button>
    <input form="edit-form" class="post btn" type="submit" value="Post">

  </div>

<% } %>
  
<% if (!locals.post) { %>
  <form action="/submit" method="POST">
    <!-- <label for="title">Title</label> -->
    <input type="text" name="title" id="title" placeholder="Post title" required>
    <!-- <label for="body">Post</label> -->
    <textarea name="post-body" id="post-body" rows="8" cols="50" maxlength="1500" placeholder="Write your post here" required></textarea>
    <input class="publish btn" type="submit" value="Publish">
  </form>
<% } %>
  
<% for (let i = 0; i < posts.length; i++) { %> 
  <div class="post-div">
    <h2><%= posts[i].title %></h2>
    <p><%= posts[i].body %></p>
    <a href="/posts/<%= posts[i].id %>" class="edit btn">Edit</a>
    <div class="hr"></div>
  </div>
<% } %>

<%- include("partials/footer.ejs") %>