<%- include("partials/header.ejs") %>

<h1>Bloggr</h1>

<% if (locals.post) { %>

  <form action="/<%= post.id %>?_method=DELETE" method="POST">
    <button type="submit">Delete</button>
  </form>
  
  <form action="/<%= post.id %>?_method=PATCH" method="POST">
    <label for="title">Title</label>
    <input type="text" name="title" id="patch-title" value="<%= post.title %>" placeholder="Post title" required>
    <label for="body">Post</label>
    <textarea name="body" id="patch-body" rows="6" cols="50" maxlength="1500" placeholder="Write your post here" required><%= post.body %></textarea>
    <input type="submit" value="Publish">
    <button type="submit" id="edit-btn">Edit</button>
  </form>
  
  <% } %>
  
  <form action="/submit" method="POST">
    <label for="title">Title</label>
    <input type="text" name="title" id="title" placeholder="Post title" required>
    <label for="body">Post</label>
    <textarea name="post-body" id="post-body" rows="6" cols="50" maxlength="1500" placeholder="Write your post here" required></textarea>
    <input type="submit" value="Publish">
    <button type="submit" id="edit-btn">Edit</button>
  </form>
  
  <% for (let i = 0; i < posts.length; i++) { %> 
    <h2><%= posts[i].title %></h2>
    <p><%= posts[i].body %></p>
  <% } %>

<%- include("partials/footer.ejs") %>